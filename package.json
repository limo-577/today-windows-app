{
  "name": "today-windows-app",
  "version": "1.5.3",
  "private": true,
  "description": "今日 - Windows 本地计划、独立悬浮窗、后台提醒、可续接专注计时与目标倒计时软件",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:web": "vite build",
    "build": "npm run build:web && electron-builder --win nsis",
    "build:portable": "npm run build:web && electron-builder --win portable",
    "build:windows": "npm run build:web && electron-builder --win nsis portable"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "vite": "6.4.3",
    "wait-on": "8.0.1"
  },
  "build": {
    "appId": "com.local.todayapp",
    "productName": "今日",
    "icon": "build/1.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "今日",
      "artifactName": "Today-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Today-Portable-${version}-${arch}.${ext}"
    }
  }
}
